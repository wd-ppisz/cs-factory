[Unit]
Description=cs-factory watchdog driver load (i6300esb)
# Why a separate unit when the module "loads by PCI ID":
# Ubuntu kernel packages ship /usr/lib/modprobe.d/blacklist_linux_<ABI>.conf with an
# "Autogenerated watchdog blacklist" section containing `blacklist i6300esb`.
# The blacklist blocks loading BY ALIAS — exactly the path udev uses to load the
# driver by the PCI ID of the device CloudStack (>=4.11) adds to every VM.
# Checked on built artifacts (guestfish): Ubuntu 22.04, 24.04 and 26.04 have the
# entry; Debian 12/13, Rocky 8/9/10 and openSUSE Leap 16 do NOT — there the module
# loads by itself and this unit is a harmless no-op.
# Proof that the blacklist is the cause, not a suspect: Ubuntu 26.04 gave an empty
# `lsmod` and no /dev/watchdog0, even though the image HAS both i6300esb.ko.zst and
# the pci:v00008086d000025AB* alias in modules.alias.
#
# Why not /etc/modules-load.d — two independent reasons:
#  1. systemd-modules-load is subject to the same blacklist: module_load_and_warn()
#     calls kmod with KMOD_PROBE_APPLY_BLACKLIST (systemd, src/shared/module-util.c),
#     so on Ubuntu it would end with "Module 'i6300esb' is deny-listed (by kmod)"
#     and nothing else;
#  2. that path was tried and reverted: a file in modules-load.d failed
#     `systemd-modules-load.service` on EVERY boot of a machine without an i6300esb
#     device. Hence loading is wrapped in its OWN unit with a tolerated failure
#     (`-` below) — a foreign system unit must not turn red because of us.
# Plain `modprobe <name>` does NOT apply the blacklist (only with `-b`, which udev
# uses) — the only path that does not require touching a distribution file. Removing
# that entry would not last anyway: it returns with the modules package on every new
# kernel ABI.
#
# Loading AFTER multi-user.target is enough: PID1 retries opening the device on every
# ping (watchdog_ping() -> open_watchdog(), systemd src/shared/watchdog.c), so arming
# from 10-csf-watchdog.conf takes effect right after the module is loaded.
# `After=multi-user.target` is mandatory here for the same reason as in
# csf-firstboot/csf-inspect — without it the target adds After= on this unit for
# itself and an ordering cycle appears, which systemd breaks by deleting a random job.
# `network-online` is needed only for the script's second job: after a kernel ABI
# change the driver has to be fetched from the repository (see
# /usr/local/sbin/csf-watchdog).
Wants=network-online.target
After=network-online.target multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
# `-` before the path ON PURPOSE (the script exits zero anyway, but a missing file
# must not break anything either): the tenant's machine must not sit in `degraded`
# state because of a unit the tenant does not know — same choice as for a failed
# update in csf-firstboot. Silent failure is guarded by three gates: the driver FILE
# in the image is checked by e2e/validate-offline.sh, actual loading and attachment by
# PID1 by e2e/smoke-boot.sh (boot with `-device i6300esb`), and the full layer on a
# live machine in CloudStack by e2e/tier3-features.py.
ExecStart=-/usr/local/sbin/csf-watchdog

[Install]
WantedBy=multi-user.target
