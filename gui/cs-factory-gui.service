[Unit]
Description=cs-factory GUI (CloudStack template factory)
After=network-online.target
Wants=network-online.target

[Service]
User=factory
Group=factory
WorkingDirectory=/srv/cs-factory/repo/gui
Environment=FACTORY_REPO=/srv/cs-factory/repo
Environment=FACTORY_ARTIFACTS=/srv/cs-factory/artifacts
# secrets (OIDC_CLIENT_SECRET, GITLAB_TOKEN, FLASK_SECRET) + site settings
# (EXTERNAL_URL, OIDC_*, GITLAB_*, CS_API_URL, ARTIFACTS_BASE_URL):
# file outside the repo, 0640 root:factory (created by gui/install.sh)
EnvironmentFile=/etc/cs-factory/gui.env
# 1 worker (the build queue lives in-process) + threads for long GitLab polls
ExecStart=/usr/bin/gunicorn --workers 1 --threads 16 --worker-class gthread \
          --timeout 0 -b 127.0.0.1:8500 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
