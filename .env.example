# CloudStack Template Factory - configuration for docker compose.
#
#   cp .env.example .env && chmod 600 .env
#
# Everything the factory can be configured with is listed here. Values marked
# REQUIRED must be set before the first start; everything else has a working
# default. After changing this file run:  docker compose up -d
# Full reference: docs/configuration.md

# =============================================================================
# Host integration
# =============================================================================

# REQUIRED - group id owning /dev/kvm on the host:   stat -c %g /dev/kvm
KVM_GID=

# Address and port the GUI and /artifacts/ are published on (nginx).
CSF_HTTP_BIND=0.0.0.0
CSF_HTTP_PORT=8080

# Host directories (bind mounts). Must be owned by uid/gid 10001:
#   sudo install -d -o 10001 -g 10001 <dir>
# work      - build directory, logs, image cache (~10-30 GB), GUI-added
#             distributions and the CloudStack keys saved from the GUI
# artifacts - finished images (~1 GB each) served under /artifacts/; put it on
#             backed-up or shared storage (NFS, CephFS, ...) if you keep templates
CSF_WORK_DIR=./data/work
CSF_ARTIFACTS_DIR=./data/artifacts

# Images to run (pin the release you tested).
CSF_IMAGE=ghcr.io/wd-ppisz/cs-factory:1.0.0
#CSF_WEB_IMAGE=nginxinc/nginx-unprivileged:1.30.6-alpine

# =============================================================================
# GUI and sign-in
# =============================================================================

# REQUIRED - session signing key:   openssl rand -hex 32
FLASK_SECRET=

# The URL users open in the browser, without a trailing slash, e.g.
# https://factory.example.com (behind a TLS proxy) or http://10.0.0.5:8080 (lab).
# Over https the session cookie is Secure; over http it is not.
EXTERNAL_URL=

# Sign-in, option A - one administrator account "admin" with this password
# (at least 12 characters recommended). Ignored when OIDC (option B) is set.
FACTORY_ADMIN_PASSWORD=

# Sign-in, option B - OIDC (Keycloak, Entra ID, Authentik, ...). Users need the
# group REQUIRED_GROUP in the `groups` (or `roles`) claim of the ID token/userinfo.
# Redirect URI to register at the provider: ${EXTERNAL_URL}/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
REQUIRED_GROUP=admins

# Force the Secure flag on the session cookie (1) or not (0). Default: derived
# from EXTERNAL_URL (https -> 1, http -> 0).
#FACTORY_COOKIE_SECURE=

# =============================================================================
# CloudStack (template registration and the live E2E test)
# =============================================================================

# API endpoint, e.g. https://cloudstack.example.com/client/api
CS_API_URL=
# API keys can also be entered on the Settings page (stored in CSF_WORK_DIR,
# never shown back). Values saved in the GUI take precedence over these.
CS_API_KEY=
CS_SECRET_KEY=

# REQUIRED for registration - URL from which the CloudStack secondary storage VM
# (SSVM) downloads finished images, i.e. this host's /artifacts/ as the SSVM
# sees it, e.g. http://10.0.0.5:8080/artifacts
ARTIFACTS_BASE_URL=

# Zone to register templates in (name); empty = the first available zone.
CS_ZONE=

# Attach the csf-inspect virtio-serial channel to registered templates (on/off).
# "on" requires account settings in CloudStack - see docs/cloudstack.md.
CSF_INSPECT_CHANNEL=on

# Live E2E test ("E2E test on a live VM" button): deploys a temporary VM.
CSF_CS_NETWORK=
CSF_CS_ZONE=
CSF_CS_SERVICE_OFFERING=
CSF_CS_PROJECT=
#E2E_CPU=2
#E2E_RAM_MB=2048
#E2E_SSH_TIMEOUT=900

# =============================================================================
# Template build parameters
# =============================================================================

# Template name prefix: "<prefix> <Distro name> v<X.Y>"; empty = no prefix.
CSF_TEMPLATE_PREFIX=Template

# Extra networks fail2ban never bans in the templates (space-separated CIDRs);
# replaces the default "127.0.0.1/8 ::1 169.254.0.0/16". Keep link-local
# 169.254.0.0/16 - it is CloudStack's control network.
#CSF_FAIL2BAN_IGNOREIP=127.0.0.1/8 ::1 169.254.0.0/16 10.0.0.0/8

# Re-download cached upstream images older than this many days.
CSF_IMAGE_MAX_AGE_DAYS=90

# Boot test: CPU model presented to the guest and the time limit (seconds).
#SMOKE_CPU=Haswell-noTSX-IBRS
#SMOKE_TIMEOUT=1800

# =============================================================================
# Optional: GitLab integration (manifests committed to a GitLab project and
# built by GitLab CI; adds the "CI status" view). Leave empty for standalone.
# =============================================================================
GITLAB_URL=
GITLAB_PROJECT=
GITLAB_TOKEN=
GITLAB_BRANCH=main
GITLAB_COMMIT_EMAIL=
